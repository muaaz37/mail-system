# Copy this file to ".env" for local development or Docker Compose.
# Local infrastructure values are evaluation defaults. Replace the SMTP/IMAP
# mailbox values and SUPPORT_MAIL_ADDRESS before starting the full system.

# Public edge ports exposed by the Snort IPS gateway
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443

# PostgreSQL settings used by docker-compose.yml
DB_USER=postgres
DB_PASSWORD=mail_system_local_db_password
DB_NAME=mail_system

# Application settings
SERVER_PORT=8080
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=25MB
APP_NAME=mail-system


# Optional datasource override for running the backend directly against PostgreSQL.
# Leave these commented out to use the backend's local H2 fallback.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mail_system
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=replace_with_local_db_password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# SeaweedFS/S3 attachment storage
STORAGE_S3_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=mail-attachments
STORAGE_S3_ACCESS_KEY=mail-system-local-access-key
STORAGE_S3_SECRET_KEY=mail-system-local-secret-key
STORAGE_S3_PATH_STYLE_ACCESS=true
STORAGE_S3_INITIALIZE_BUCKET=true

# SMTP account used for outgoing mails.
# THM ITS documents mailgate.thm.de as the mail server for sending mail.
MAIL_SMTP_HOST=mailgate.thm.de
MAIL_SMTP_PORT=465
# THM: use your THM-Benutzerkennung here, not your email address.
MAIL_SMTP_USERNAME=replace_with_thm_username
MAIL_SMTP_PASSWORD=replace_with_mailbox_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_PROTOCOL=smtp
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_SSL_ENABLE=true

# IMAP account used for incoming support mails.
# THM ITS documents mailgate.thm.de as the mail server for receiving mail.
MAIL_IMAP_HOST=mailgate.thm.de
MAIL_IMAP_PORT=993
# THM: use your THM-Benutzerkennung here, not your email address.
MAIL_IMAP_USERNAME=replace_with_thm_username
MAIL_IMAP_PASSWORD=replace_with_mailbox_password
MAIL_IMAP_PROTOCOL=imaps
MAIL_IMAP_FOLDER=INBOX

# Support mailbox behavior
MAIL_POLLING_INTERVAL_MS=10000
MAILBOX_REFRESH_INTERVAL_MS=10000
MAILBOX_REFRESH_TIMEOUT_MS=10000
SUPPORT_MAIL_ADDRESS=support@example.org


# keycloak settings for authentication and authorization
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=mail_system_local_admin_password
KEYCLOAK_ISSUER_URI=https://localhost/realms/mail-support
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/mail-support/protocol/openid-connect/certs

# Keycloak database settings
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=mail_system_keycloak_db_password
