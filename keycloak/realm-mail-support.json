  "displayName": "Mail Support System",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "mail-client",
      "name": "Mail System Angular Client",
      "description": "Public Angular client for the Mail Support System",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost/app/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "https://localhost",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost/app/*##http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
