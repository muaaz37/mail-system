# Local Snort IPS rules.
# Local SIDs start at 1000000 to avoid conflicts with community rules.

# 1. Block requests containing the explicit IPS test header.
drop tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL IPS blocking test"; content:"X-IPS-Test|3A| block",nocase; sid:1000001; rev:4;)

# 2. Detect requests generated by the sqlmap security scanner.
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL SQLMap scanner detected"; content:"sqlmap",nocase; sid:1000002; rev:2;)

# 3. Detect requests generated by the Nikto security scanner.
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL Nikto scanner detected"; content:"Nikto",nocase; sid:1000003; rev:2;)

# 4. Block attempts to access an exposed environment file.
drop tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL Environment file access attempt"; content:"/.env",nocase; sid:1000004; rev:2;)

# 5. Block Unix password file access attempts.
drop tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL Unix password file access attempt"; content:"/etc/passwd",nocase; sid:1000005; rev:2;)

# 6. Detect an unusually high number of TCP connection attempts.
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"LOCAL High TCP connection rate detected"; flags:S; detection_filter:track by_src,count 30,seconds 10; sid:1000006; rev:1;)
