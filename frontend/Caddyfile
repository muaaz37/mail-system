:8080 {
	root * /srv
	header {
		Cache-Control "no-store"
	}

	@rootSpaRoutes path /mails /mails/* /login /404
	redir @rootSpaRoutes /app{uri} 308

	handle /node_modules/* {
		file_server
	}

	handle /app/runtime-config.js {
		root * /config
		rewrite * /runtime-config.js
		header Cache-Control "no-store"
		file_server
	}

	handle_path /app/* {
		try_files {path} /index.html
		file_server
	}

	redir / /app/ 308
	redir /app /app/ 308

	handle {
		redir /app/404 308
	}
}
